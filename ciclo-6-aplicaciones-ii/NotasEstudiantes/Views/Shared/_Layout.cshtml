<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Politecnico Internacional</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/notas.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-notas mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Estudiantes" asp-action="Index">
                Cálculo de Nota Definitiva
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Estudiantes" asp-action="Index">Lista de Estudiantes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Estudiantes" asp-action="Create">Registrar Notas</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <footer class="footer-notas mb-3">
        <small>&copy; @DateTime.Now.Year - Desarrollado por edmsoft para el Politécnico Internacional</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
